@startuml
!include estilo.iuml
left to right direction
actor "Persona\nusuaria" as P
actor "Servicio de IA\n(Claude)" as IA
rectangle "Kinetia" {
  usecase "Completar perfil\ny cuestionario" as UC1
  usecase "Editar o\neliminar perfil" as UC11
  usecase "Ver semana\ny progresión" as UC10
  usecase "Generar rutina\ncon IA" as UC3
  usecase "Preparar la sesión\n(ajustes y confirmaciones)" as UC2
  usecase "Usar la rutina\npor reglas" as UC4
  usecase "Ver la rutina\ny sus motivos" as UC5
  usecase "Realizar la\nsesión guiada" as UC6
  usecase "Registrar\ncómo le fue" as UC9
  usecase "Ver la técnica\npaso a paso" as UC7
  usecase "Detener\npor dolor" as UC8
}
P --> UC1
P --> UC11
P --> UC10
P --> UC3
P --> UC5
P --> UC6
UC3 --> IA
UC3 ..> UC2 : <<include>>
UC3 <.. UC4 : <<extend>>\n(si la IA falla)
UC6 ..> UC9 : <<include>>
UC6 <.. UC7 : <<extend>>
UC6 <.. UC8 : <<extend>>
@enduml
