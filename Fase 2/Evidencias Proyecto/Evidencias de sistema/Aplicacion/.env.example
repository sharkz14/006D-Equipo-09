# Copia este archivo como .env.local (Git lo ignora) y ajusta los valores.
# Sin EXPO_PUBLIC_KINETIA_IA_URL la app genera la rutina por reglas, como antes.
#
# Servidor en tu computador visto desde el emulador de Android:
EXPO_PUBLIC_KINETIA_IA_URL=http://10.0.2.2:8787
#
# Opcional: debe coincidir con KINETIA_TOKEN del servidor. No es una clave secreta:
# todo lo que empieza con EXPO_PUBLIC_ queda visible dentro de la app.
EXPO_PUBLIC_KINETIA_IA_TOKEN=
#
# La clave de Claude (ANTHROPIC_API_KEY) NUNCA va aquí: solo en el servidor.
